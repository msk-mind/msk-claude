#!/usr/bin/env python3
"""Entry point for the aiportal command; the implementation is in lib/aiportal.py."""
import os
import sys

REPO_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

# Run inside the repo's private environment when it exists (created by install.sh)
VENV_PYTHON = os.path.join(REPO_DIR, ".venv", "bin", "python")
if os.path.exists(VENV_PYTHON) and os.path.realpath(sys.prefix) != os.path.realpath(os.path.join(REPO_DIR, ".venv")):
    os.execv(VENV_PYTHON, [VENV_PYTHON, os.path.realpath(__file__), *sys.argv[1:]])

# Without a working environment, say how to fix it instead of failing with a traceback.
# (This file must stay parseable by old Pythons, e.g. a system python3 3.6.)
try:
    if sys.version_info < (3, 10):
        raise ImportError("Python {}.{} is too old".format(*sys.version_info[:2]))
    import requests  # noqa: F401
    import ruamel.yaml  # noqa: F401
except ImportError as e:
    sys.exit("aiportal can't run: {}.\nRun {} to set up its Python environment.".format(
        e, os.path.join(REPO_DIR, "install.sh")))

sys.path.insert(0, os.path.join(REPO_DIR, "lib"))

import aiportal  # noqa: E402

sys.exit(aiportal.main(sys.argv[1:]))
