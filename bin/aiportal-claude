#!/bin/bash
# Wrapper script to connect Claude CLI to Open WebUI

# Get script directory before any directory changes (resolving the aiportal-claude symlink)
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
AIPORTAL="$REPO_DIR/bin/aiportal"

# Default model
DEFAULT_MODEL="claude-sonnet-5.5"
# Model names come from litellm_config.yaml
mapfile -t AVAILABLE_MODELS < <("$AIPORTAL" models)

# Parse arguments
MODEL="$DEFAULT_MODEL"
WORK_DIR=""
RESUME_ARGS=()
FORK=0

show_usage() {
    local cmd
    cmd="$(basename "$0")"
    echo "Usage: $cmd [OPTIONS] [working_directory]"
    echo ""
    echo "Options:"
    echo "  -m, --model MODEL    Model to use (default: $DEFAULT_MODEL)"
    echo "  -c, --continue       Continue the most recent conversation in the directory"
    echo "  -r, --resume [ID]    Resume a conversation; without an ID, pick one from a list"
    echo "      --fork           With -c or -r, continue in a copy and leave the original as is"
    echo "  -h, --help           Show this help message"
    echo ""
    echo "Available models:"
    for m in "${AVAILABLE_MODELS[@]}"; do
        if [ "$m" = "$DEFAULT_MODEL" ]; then
            echo "  - $m (default)"
        else
            echo "  - $m"
        fi
    done
    echo ""
    echo "Examples:"
    echo "  $cmd                              # Use default model in current directory"
    echo "  $cmd /path/to/project             # Use default model in specified directory"
    echo "  $cmd -m claude-opus-5.5           # Use specific model in current directory"
    echo "  $cmd -m gpt-5.6-terra /path       # Use specific model in specified directory"
    echo "  $cmd -c                           # Pick up where you left off"
    echo "  $cmd -r                           # Choose a conversation to resume"
    echo ""
    echo "Update the model list from the MSK endpoint with: aiportal models sync --apply"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -m|--model)
            if [ -z "$2" ] || [[ "$2" == -* ]]; then
                echo "Error: $1 needs a model name"
                show_usage
                exit 1
            fi
            MODEL="$2"
            shift 2
            ;;
        -c|--continue)
            RESUME_ARGS+=(--continue)
            shift
            ;;
        -r|--resume)
            # The session ID is optional; without one Claude Code shows a picker.
            # Treat the next argument as an ID unless it is an option or a directory.
            if [ -n "$2" ] && [[ "$2" != -* ]] && [ ! -d "$2" ]; then
                RESUME_ARGS+=(--resume "$2")
                shift 2
            else
                RESUME_ARGS+=(--resume)
                shift
            fi
            ;;
        --fork)
            FORK=1
            shift
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        -*)
            echo "Error: Unknown option $1"
            show_usage
            exit 1
            ;;
        *)
            if [ -n "$WORK_DIR" ]; then
                echo "Error: more than one working directory given ($WORK_DIR, $1)"
                exit 1
            fi
            WORK_DIR="$1"
            shift
            ;;
    esac
done
WORK_DIR="${WORK_DIR:-.}"

if [ "$FORK" = 1 ]; then
    if [ ${#RESUME_ARGS[@]} -eq 0 ]; then
        echo "Error: --fork needs -c or -r"
        exit 1
    fi
    RESUME_ARGS+=(--fork-session)
fi

# Validate model selection
if [[ ! " ${AVAILABLE_MODELS[@]} " =~ " ${MODEL} " ]]; then
    echo "Error: Invalid model '$MODEL'"
    echo "Available models: ${AVAILABLE_MODELS[*]}"
    exit 1
fi

# Validate and change to working directory
if [ ! -d "$WORK_DIR" ]; then
    echo "Error: Working directory does not exist: $WORK_DIR"
    exit 1
fi

cd "$WORK_DIR"
echo "Working directory: $(pwd)"
echo "Model: $MODEL"
echo ""

# Set up Claude environment
source "$REPO_DIR/lib/claude_env.sh" || exit 1

# Launch Claude CLI with selected model
echo "Launching Claude CLI..."
echo "Server: https://chat.aicopilot.aws.mskcc.org"
echo "This may take 10-30 seconds to initialize..."
echo "Press Ctrl+D or type 'exit' to quit"
echo ""

exec claude --model "$MODEL" "${RESUME_ARGS[@]}"
